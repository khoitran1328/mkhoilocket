#!name=Locket Gold VIP [CAT Commercial]
#!desc=Bản quyền thuộc về CAT. Vui lòng không sao chép.
#!author=CAT (OMEGA)
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/TestFlight.png
#!system=ios

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP
DOMAIN,firebasestorage.googleapis.com,DIRECT
DOMAIN-SUFFIX,firebasestorage.app,DIRECT
DOMAIN,storage.googleapis.com,DIRECT
DOMAIN-SUFFIX,appspot.com,DIRECT
DOMAIN,firebaseinstallations.googleapis.com,DIRECT
DOMAIN,identitytoolkit.googleapis.com,DIRECT
DOMAIN,securetoken.googleapis.com,DIRECT
AND,((DOMAIN,firebaseremoteconfig.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.revenuecat.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,us-central1-locket-4252a.cloudfunctions.net),(PROTOCOL,UDP)),REJECT
DOMAIN-SUFFIX,sentry.io,REJECT
DOMAIN-SUFFIX,ingest.sentry.io,REJECT

[URL Rewrite]
^https?:\/\/locket-pro-backend\.onrender\.com\/(?:assets\/widget_frames|assets\/frames|uploads\/frames)\/(.+?)(?:_system(?:Small|Medium|Large|ExtraLarge))?(?:@[0-9]x)?\.png(\?.*)?$ https://locket-pro-backend.onrender.com/assets/frames/$1.png$2 302
^https?:\/\/i\.ibb\.co\/(.+?)(?:_system(?:Small|Medium|Large|ExtraLarge))?(?:@[0-9]x)?\.png(\?.*)?$ https://i.ibb.co/$1.png$2 302
^https?:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/generateFilteredImage https://locket-pro-backend.onrender.com/generateFilteredImage?token=VIP-COMMERCIAL-CAT 307

[Header Rewrite]
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del x-revenuecat-etag
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del X-RevenueCat-ETag
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del if-none-match
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del If-None-Match
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del if-modified-since
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del If-Modified-Since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del if-none-match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del If-None-Match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del if-modified-since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del If-Modified-Since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del x-goog-if-none-match
^https?:\/\/api\.locketcamera\.com\/.+ header-del if-none-match
^https?:\/\/api\.locketcamera\.com\/.+ header-del If-None-Match
^https?:\/\/api\.locketcamera\.com\/.+ header-del if-modified-since
^https?:\/\/api\.locketcamera\.com\/.+ header-del If-Modified-Since

[Script]
locket_rc = type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers),script-path=https://raw.githubusercontent.com/khoitran1328/mkhoilocket/main/Locket_CAT.js,requires-body=true,max-size=-1,timeout=60
locket_fb = type=http-response,pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+,script-path=https://raw.githubusercontent.com/khoitran1328/mkhoilocket/main/Locket_CAT.js,requires-body=true,max-size=-1,timeout=60
locket_api = type=http-response,pattern=^https?:\/\/api\.locketcamera\.com\/.+,requires-body=true,max-size=-1,script-path=https://raw.githubusercontent.com/khoitran1328/mkhoilocket/main/Locket_CAT.js,timeout=60
youtube_api = type=http-response,pattern=^https?:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/khoitran1328/mkhoilocket/main/Locket_CAT.js
spotify_api = type=http-response,pattern=^https?:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(?::443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album|bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize),requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/khoitran1328/mkhoilocket/main/Locket_CAT.js

[Host]
firebaseremoteconfigrealtime.googleapis.com = 0.0.0.0

[MITM]
hostname = %APPEND% -firebasestorage.googleapis.com, -*.firebasestorage.app, -storage.googleapis.com, -*.appspot.com, -firebaseinstallations.googleapis.com, -identitytoolkit.googleapis.com, -securetoken.googleapis.com, *.googlevideo.com, youtubei.googleapis.com, api.revenuecat.com, firebaseremoteconfig.googleapis.com, spclient.wg.spotify.com, *spclient.spotify.com, api.locketcamera.com, *.locketcamera.com, us-central1-locket-4252a.cloudfunctions.net, locket-pro-backend.onrender.com, i.ibb.co
